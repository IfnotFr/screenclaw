{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "#/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "test-local.ts",
    "src/bootstrap.ts",
    "tests/core/utils"
  ],
  "exclude": [
    "node_modules"
  ]
}