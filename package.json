{
  "name": "screen-claw",
  "version": "0.1.0",
  "description": "Autonomous AI Desktop Agent using Computer Vision and a hierarchical multi-agent architecture",
  "type": "module",
  "bin": {
    "screen-claw": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "missions",
    ".env.example"
  ],
  "imports": {
    "#/*": "./src/*.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "dev:admin": "cd src/admin && npm run dev",
    "agent": "tsx src/run-agent.ts",
    "build:admin": "cd src/admin && npm run build",
    "build": "tsup && npm run build:admin",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "@clack/prompts": "^1.2.0",
    "ai": "^6.0.116",
    "ai-sdk-agentic": "^1.0.1",
    "boxen": "^8.0.1",
    "canvas": "^3.1.0",
    "chalk": "^5.6.2",
    "dbus-next": "^0.10.2",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "ioctl": "^2.0.2",
    "node-cron": "^4.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/node-cron": "^3.0.11",
    "node-gyp": "^12.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
