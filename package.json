{
  "name": "screen-claw",
  "version": "0.1.0",
  "description": "Autonomous AI Desktop Agent using Computer Vision and a hierarchical multi-agent architecture",
  "type": "module",
  "bin": {
    "screen-claw": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "missions",
    ".env.example"
  ],
  "imports": {
    "#/*": "./src/*.js"
  },
  "scripts": {
    "dev": "npm run dev:server & npm run dev:admin",
    "dev:server": "tsx src/cli.ts",
    "dev:admin": "cd src/admin && npm run dev",
    "agent": "tsx src/run-agent.ts",
    "build:admin": "cd src/admin && npm run build",
    "build": "tsup && npm run build:admin",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "@clack/prompts": "^1.2.0",
    "@types/screenshot-desktop": "^1.15.0",
    "ai": "^6.0.116",
    "ai-sdk-agentic": "file:../ai-sdk-agentic/packages/core",
    "ai-sdk-office-server": "file:../ai-sdk-agentic/packages/ai-sdk-office-server",
    "boxen": "^8.0.1",
    "canvas": "^3.1.0",
    "chalk": "^5.6.2",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "node-cron": "^4.2.1",
    "screenshot-desktop": "^1.15.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/node-cron": "^3.0.11",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
